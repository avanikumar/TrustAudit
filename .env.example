# Copy to .env (never commit .env) or export these in your shell.
# With no key set, TrustAudit uses the offline template writer.
GROQ_API_KEY=your-key-here
# Optional overrides (defaults shown):
# TRUSTAUDIT_API_KEY_ENV=GROQ_API_KEY
# TRUSTAUDIT_BASE_URL=https://api.groq.com/openai/v1
# TRUSTAUDIT_MODEL=llama-3.3-70b-versatile
# TRUSTAUDIT_DATASET=telco
